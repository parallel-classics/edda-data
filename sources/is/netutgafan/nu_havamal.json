    "magran mar kaupa,",
    "en mæki saurgan,",
    "heima hest feita,",
    "en hund á búi."
   ]
  },
  {
   "t": "head",
   "s": "II. Mansöngur"
  },
  {
   "t": "v",
   "l": [
    "Meyjar orðum",
