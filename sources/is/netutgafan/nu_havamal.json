    "ormi hringlegnum,",
    "brúðar beðmálum",
    "eða brotnu sverði,",
    "bjarnar leiki",
    "eða barni konungs,"
   ]
  },
  {
   "t": "v",
   "l": [
    "Sjúkum kálfi,",
    "sjálfráða þræli,",
    "völu vilmæli,",
    "val nýfelldum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Akri ársánum",
