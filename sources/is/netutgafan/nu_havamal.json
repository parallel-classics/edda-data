{
 "title": "Hávamál",
 "edition_note": "",
 "units": [
  {
   "t": "head",
   "s": "I. Geðspeki"
  },
  {
   "t": "v",
   "l": [
    "Gáttir allar",
    "áður gangi fram",
    "um skoðast skyli,",
    "um skyggnast skyli,",
    "því að óvíst er að vita",
    "hvar óvinir",
    "sitja á fleti fyrir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Gefendur heilir!",
    "Gestur er inn kominn!",
    "hvar skal sitja sjá?",
    "Mjög er bráður",
    "sá er á bröndum skal",
    "síns um freista frama."
   ]
  },
  {
   "t": "v",
   "l": [
    "Elds er þörf",
    "þeim er inn er kominn",
    "og á kné kalinn.",
    "Matar og voða",
    "er manni þörf,",
    "þeim er hefir um fjall farið."
   ]
  },
  {
   "t": "v",
   "l": [
    "Vatns er þörf",
    "þeim er til verðar kemur,",
    "þerru og þjóðlaðar,",
    "góðs um æðis",
    "ef sér geta mætti",
    "orðs og endurþögu."
   ]
  },
  {
   "t": "v",
   "l": [
    "Vits er þörf",
    "þeim er víða ratar.",
    "Dælt er heima hvað.",
    "Að augabragði verður",
    "sá er ekki kann",
    "og með snotrum situr."
   ]
  },
  {
   "t": "v",
   "l": [
    "Að hyggjandi sinni",
    "skyli-t maður hræsinn vera,",
    "heldur gætinn að geði.",
    "Þá er horskur og þögull",
    "kemur heimisgarða til,",
    "sjaldan verður víti vörum.",
    "Því að óbrigðra vin",
    "fær maður aldregi",
    "en mannvit mikið."
   ]
  },
  {
   "t": "v",
   "l": [
    "Inn vari gestur",
    "er til verðar kemur",
    "þunnu hljóði þegir,",
    "eyrum hlýðir,",
    "en augum skoðar.",
    "Svo nýsist fróðra hver fyrir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Hinn er sæll",
    "er sér um getur",
    "lof og líknstafi.",
    "Ódælla er við það",
    "er maður eiga skal",
    "annars brjóstum í."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sá er sæll",
    "er sjálfur um á",
    "lof og vit meðan lifir.",
    "Því að ill ráð",
    "hefir maður oft þegið",
    "annars brjóstum úr."
   ]
  },
  {
   "t": "v",
   "l": [
    "Byrði betri",
    "ber-at maður brautu að",
    "en sé mannvit mikið.",
    "Auði betra",
    "þykir það í ókunnum stað.",
    "Slíkt er volaðs vera."
   ]
  },
  {
   "t": "v",
   "l": [
    "Byrði betri",
    "ber-at maður brautu að",
    "en sé mannvit mikið.",
    "Vegnest verra",
    "vegur-a hann velli að",
    "en sé ofdrykkja öls."
   ]
  },
  {
   "t": "v",
   "l": [
    "Er-a svo gott",
    "sem gott kveða",
    "öl alda sonum,",
    "því að færra veit",
    "er fleira drekkur",
    "síns til geðs gumi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Óminnishegri heitir",
    "sá er yfir öldrum þrumir.",
    "Hann stelur geði guma.",
    "Þess fugls fjöðrum",
    "eg fjötraður var'g",
    "í garði Gunnlaðar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ölur eg varð,",
    "varð ofurölvi",
    "að ins fróða Fjalars.",
    "Því er öldur best",
    "að aftur um heimtir",
    "hver sitt geð gumi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þagalt og hugalt",
    "skyldi þjóðans barn",
    "og vígdjarft vera.",
    "Glaður og reifur",
    "skyli gumna hver",
    "uns sinn bíður bana."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ósnjallur maður",
    "hyggst munu ey lifa,",
    "ef hann við víg varast.",
    "En elli gefur",
    "honum engi frið,",
    "þótt honum geirar gefi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Kópir afglapi",
    "er til kynnis kemur,",
    "þylst hann um eða þrumir",
    "Allt er senn,",
    "ef hann sylg um getur,",
    "uppi er þá geð guma."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sá einn veit",
    "er víða ratar",
    "og hefir fjöld um farið",
    "hverju geði",
    "stýrir gumna hver,",
    "sá er vitandi er vits."
   ]
  },
  {
   "t": "v",
   "l": [
    "Haldi-t maður á keri,",
    "drekki þó af hófi mjöð,",
    "mæli þarft eða þegi.",
    "Ókynnist þess",
    "váar þig engi maður",
    "að þú gangir snemma að sofa."
   ]
  },
  {
   "t": "v",
   "l": [
    "Gráðugur halur,",
    "nema geðs viti,",
    "etur sér aldurtrega.",
    "Oft fær hlægis",
    "er með horskum kemur",
    "manni heimskum magi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Hjarðir það vitu",
    "nær þær heim skulu",
    "og ganga þá af grasi.",
    "En ósvinnur maður",
    "kann æva-gi",
    "síns um mál maga."
   ]
  },
  {
   "t": "v",
   "l": [
    "Vesall maður",
    "og illa skapi",
    "hlær að hvívetna.",
    "Hitt-ki hann veit",
    "er hann vita þyrfti",
    "að hann er-a vamma vanur."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ósvinnur maður",
    "vakir um allar nætur",
    "og hyggur að hvívetna.",
    "Þá er móður",
    "er að morgni kemur.",
    "Allt er víl sem var."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ósnotur maður",
    "hyggur sér alla vera",
    "viðhlæjendur vini.",
    "Hitt-ki hann finnur,",
    "þótt þeir um hann fár lesi,",
    "ef hann með snotrum situr."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ósnotur maður",
    "hyggur sér alla vera",
    "viðhlæjendur vini.",
    "Þá það finnur",
    "er að þingi kemur",
    "að hann á formælendur fáa."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ósnotur maður",
    "þykist allt vita,",
    "ef hann á sér í vá veru.",
    "Hitt-ki hann veit",
    "hvað hann skal við kveða,",
    "ef hans freista firar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ósnotur maður",
    "er með aldir kemur,",
    "það er best að hann þegi.",
    "Engi það veit",
    "að hann ekki kann,",
    "nema hann mæli til margt.",
    "Veit-a maður",
    "hinn er vætki veit,",
    "þótt hann mæli til margt."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fróður sá þykist",
    "er fregna kann",
    "og segja ið sama.",
    "Eyvitu leyna",
    "megu ýta synir",
    "því er gengur um guma."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ærna mælir",
    "sá er æva þegir",
    "staðlausu stafi.",
    "Hraðmælt tunga,",
    "nema haldendur eigi,",
    "oft sér ógott um gelur."
   ]
  },
  {
   "t": "v",
   "l": [
    "Að augabragði",
    "skal-a maður annan hafa,",
    "þótt til kynnis komi.",
    "Margur þá fróður þykist",
    "ef hann freginn er-at",
    "og nái hann þurrfjallur þruma."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fróður þykist",
    "sá er flótta tekur",
    "gestur að gest hæðinn.",
    "Veit-a gjörla",
    "sá er um verði glissir,",
    "þótt hann með grömum glami."
   ]
  },
  {
   "t": "v",
   "l": [
    "Gumnar margir",
    "erust gagnhollir",
    "en að virði vrekast.",
    "Aldar róg",
    "það mun æ vera:",
    "Órir gestur við gest."
   ]
  },
  {
   "t": "v",
   "l": [
    "Árlega verðar",
    "skyli maður oft fá,",
    "nema til kynnis komi.",
    "Situr og snópir,",
    "lætur sem sólginn sé",
    "og kann fregna að fáu."
   ]
  },
  {
   "t": "v",
   "l": [
    "Afhvarf mikið",
    "er til ills vinar,",
    "þótt á brautu búi.",
    "En til góðs vinar",
    "liggja gagnvegir,",
    "þótt hann sé firr farinn."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ganga skal,",
    "skal-a gestur vera",
    "ey í einum stað.",
    "Ljúfur verður leiður,",
    "ef lengi situr",
    "annars fletjum á."
   ]
  },
  {
   "t": "v",
   "l": [
    "Bú er betra,",
    "þótt lítið sé.",
    "Halur er heima hver.",
    "Þótt tvær geitur eigi",
    "og taugreftan sal,",
    "það er þó betra en bæn."
   ]
  },
  {
   "t": "v",
   "l": [
    "Bú er betra,",
    "þótt lítið sé.",
    "Halur er heima hver.",
    "Blóðugt er hjarta",
    "þeim er biðja skal",
    "sér í mál hvert matar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Vopnum sínum",
    "skal-a maður velli á",
    "feti ganga framar,",
    "því að óvíst er að vita",
    "nær verður á vegum úti",
    "geirs um þörf guma."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fann'g-a eg mildan mann",
    "eða svo matargóðan",
    "að ei væri þiggja þegið,",
    "eða síns fjár",
    "svo gjafa fúsan",
    "að leið sé laun, ef þægi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fjár síns",
    "er fengið hefir",
    "skyli-t maður þörf þola.",
    "Oft sparir leiðum",
    "það er hefir ljúfum hugað.",
    "Margt gengur verr en varir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Vopnum og voðum",
    "skulu vinir gleðjast:",
    "það er á sjálfum sýnst.",
    "Viðurgefendur og endurgefendur",
    "erust lengst vinir,",
    "ef það bíður að verða vel."
   ]
  },
  {
   "t": "v",
   "l": [
    "Vin sínum",
    "skal maður vinur vera",
    "og gjalda gjöf við gjöf.",
    "Hlátur við hlátri",
    "skyli höldar taka",
    "en lausung við lygi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Vin sínum",
    "skal maður vinur vera,",
    "þeim og þess vin.",
    "En óvinar síns",
    "skyli engi maður",
    "vinar vinur vera."
   ]
  },
  {
   "t": "v",
   "l": [
    "Veistu ef þú vin átt,",
    "þann er þú vel trúir,",
    "og vilt þú af honum gott geta,",
    "geði skaltu við þann blanda",
    "og gjöfum skipta,",
    "fara að finna oft."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ef þú átt annan,",
    "þann er þú illa trúir,",
    "Viltu af honum þó gott geta,",
    "fagurt skaltu við þann mæla",
    "en flátt hyggja",
    "og gjalda lausung við lygi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Það er enn um þann",
    "er þú illa trúir",
    "og þér er grunur að hans geði:",
    "hlæja skaltu við þeim",
    "og um hug mæla.",
    "Glík skulu gjöld gjöfum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ungur var eg forðum,",
    "fór eg einn saman:",
    "þá varð eg villur vega.",
    "Auðigur þóttumst",
    "er eg annan fann:",
    "Maður er manns gaman."
   ]
  },
  {
   "t": "v",
   "l": [
    "Mildir, fræknir",
    "menn best lifa,",
    "sjaldan sút ala.",
    "En ósnjallur maður",
    "uggir hotvetna:",
    "Sýtir æ glöggur við gjöfum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Voðir mínar",
    "gaf eg velli að",
    "tveim trémönnum.",
    "Rekkar það þóttust",
    "er þeir rift höfðu:",
    "Neis er nökkvinn halur."
   ]
  },
  {
   "t": "v",
   "l": [
    "Hrörnar þöll",
    "sú er stendur þorpi á.",
    "Hlýr-at henni börkur né barr.",
    "Svo er maður",
    "sá er manngi ann.",
    "Hvað skal hann lengi lifa?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Eldi heitari",
    "brennur með illum vinum",
    "friður fimm daga,",
    "en þá slokknar",
    "er inn sétti kemur",
    "og versnar allur vinskapur."
   ]
  },
  {
   "t": "v",
   "l": [
    "Mikið eitt",
    "skal-a manni gefa:",
    "Oft kaupir sér í litlu lof.",
    "Með hálfum hleif",
    "og með höllu keri",
    "fékk eg mér félaga."
   ]
  },
  {
   "t": "v",
   "l": [
    "Lítilla sanda",
    "lítilla sæva",
    "lítil eru geð guma.",
    "Því að allir menn",
    "urðu-t jafnspakir:",
    "Hálf er öld hvar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Meðalsnotur",
    "skyli manna hver:",
    "æva til snotur sé.",
    "Þeim er fyrða",
    "fegurst að lifa",
    "er vel margt vitu."
   ]
  },
  {
   "t": "v",
   "l": [
    "Meðalsnotur",
    "skyli manna hver:",
    "æva til snotur sé.",
    "Því að snoturs manns hjarta",
    "verður sjaldan glatt,",
    "ef sá er alsnotur er á."
   ]
  },
  {
   "t": "v",
   "l": [
    "Meðalsnotur",
    "skyli manna hver:",
    "æva til snotur sé.",
    "Örlög sín",
    "viti engi fyrir:",
    "þeim er sorgalausastur sefi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Brandur af brandi",
    "brennur uns brunninn er.",
    "Funi kveikist af funa.",
    "Maður af manni",
    "verður að máli kunnur",
    "en til dælskur af dul."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ár skal rísa",
    "sá er annars vill",
    "fé eða fjör hafa.",
    "Sjaldan liggjandi úlfur",
    "lær um getur",
    "né sofandi maður sigur."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ár skal rísa",
    "sá er á yrkjendur fáa",
    "og ganga síns verka á vit.",
    "Margt um dvelur",
    "þann er um morgun sefur.",
    "Hálfur er auður und hvötum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þurra skíða",
    "og þakinna næfra,",
    "þess kann maður mjöt",
    "og þess viðar",
    "er vinnast megi",
    "mál og misseri."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þveginn og mettur",
    "ríði maður þingi að,",
    "þótt hann sé-t væddur til vel.",
    "Skúa og bróka",
    "skammist engi maður",
    "né hests in heldur,",
    "þátt hann hafi-t góðan"
   ]
  },
  {
   "t": "v",
   "l": [
    "Snapir og gnapir,",
    "er til sævar kemur,",
    "örn á aldinn mar:",
    "Svo er maður",
    "er með mörgum kemur",
    "og á formælendur fáa."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fregna og segja",
    "skal fróðra hver,",
    "sá er vill heitinn horskur.",
    "Einn vita",
    "né annar skal.",
    "Þjóð veit, ef þrír eru."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ríki sitt",
    "skyli ráðsnotra hver",
    "í hófi hafa.",
    "Þá hann það finnur",
    "er með fræknum kemur",
    "að engi er einna hvatastur."
   ]
  },
  {
   "t": "v",
   "l": [
    "Orða þeira",
    "er maður öðrum segir",
    "oft hann gjöld um getur."
   ]
  },
  {
   "t": "v",
   "l": [
    "Mikilsti snemma",
    "kom eg í marga staði",
    "en til síð í suma.",
    "Öl var drukkið,",
    "sumt var ólagað:",
    "Sjaldan hittir leiður í lið."
   ]
  },
  {
   "t": "v",
   "l": [
    "Hér og hvar",
    "myndi mér heim of boðið,",
    "ef þyrfta'g að málungi mat,",
    "eða tvö lær hengi",
    "að ins tryggva vinar,",
    "þar er eg hafði eitt etið."
   ]
  },
  {
   "t": "v",
   "l": [
    "Eldur er bestur",
    "með ýta sonum",
    "og sólar sýn,",
    "heilyndi sitt,",
    "ef maður hafa náir,",
    "án við löst að lifa."
   ]
  },
  {
   "t": "v",
   "l": [
    "Era-t maður alls vesall,",
    "þátt hann sé illa heill:",
    "Sumur er af sonum sæll,",
    "sumur af frændum,",
    "sumur af fé ærnu,",
    "sumur af verkum vel."
   ]
  },
  {
   "t": "v",
   "l": [
    "Betra er lifðum",
    "og sællifðum.",
    "Ey getur kvikur kú.",
    "Eld sá eg upp brenna",
    "auðgum manni fyrir,",
    "en úti var dauður fyr durum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Haltur ríður hrossi,",
    "hjörð rekur handarvanur,",
    "daufur vegur og dugir.",
    "Blindur er betri",
    "en brenndur sé:",
    "Nýtur manngi nás."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sonur er betri,",
    "þótt sé síð of alinn",
    "eftir genginn guma:",
    "Sjaldan bautarsteinar",
    "standa brautu nær,",
    "nema reisi niður að nið."
   ]
  },
  {
   "t": "v",
   "l": [
    "Tveir eru eins herjar:",
    "Tunga er höfuðs bani.",
    "Er mér í héðin hvern",
    "handar væni."
   ]
  },
  {
   "t": "v",
   "l": [
    "Nótt verður feginn",
    "sá er nesti trúir.",
    "Skammar eru skips rár.",
    "Hverf er haustgríma.",
    "Fjöld um viðrir",
    "á fimm dögum",
    "en meira á mánuði."
   ]
  },
  {
   "t": "v",
   "l": [
    "Veit-a hinn",
    "er vætki veit:",
    "Margur verður af aurum api.",
    "Maður er auðigur,",
    "annar óauðigur,",
    "skyli-t þann vítka vár."
   ]
  },
  {
   "t": "v",
   "l": [
    "Deyr fé,",
    "deyja frændur,",
    "deyr sjálfur ið sama.",
    "En orðstír",
    "deyr aldregi",
    "hveim er sér góðan getur."
   ]
  },
  {
   "t": "v",
   "l": [
    "Deyr fé,",
    "deyja frændur,",
    "deyr sjálfur ið sama.",
    "Eg veit einn",
    "að aldrei deyr:",
    "dómur um dauðan hvern."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fullar grindur",
    "sá eg fyr Fitjungs sonum.",
