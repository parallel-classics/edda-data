{
 "title": "Þrymskviða",
 "edition_note": "Netútgáfan janúar 1997",
 "units": [
  {
   "t": "v",
   "l": [
    "Reiður var þá Vingþór",
    "er hann vaknaði",
    "og síns hamars",
    "um saknaði,",
    "skegg nam að hrista,",
    "skör nam að dýja,",
    "réð Jarðar bur",
    "um að þreifast."
   ]
  },
  {
   "t": "v",
   "l": [
    "Og hann það orða",
    "alls fyrst um kvað:",
    "Heyrðu nú, Loki,",
    "hvað eg nú mæli",
    "er eigi veit",
    "Jarðar hvergi",
    "né upphimins:",
    "ás er stolinn hamri."
   ]
  },
  {
   "t": "v",
   "l": [
    "Gengu þeir fagra",
    "Freyju túna",
    "og hann það orða",
    "alls fyrst um kvað:",
    "Muntu mér, Freyja,",
    "fjaðurhams ljá",
    "ef eg minn hamar",
    "mættag hitta."
   ]
  },
  {
   "t": "sp",
   "s": "Freyja kvað:"
  },
  {
   "t": "v",
   "l": [
    "Þó mynda eg gefa þér",
    "þótt úr gulli væri",
    "og þó selja",
    "að væri úr silfri."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fló þá Loki,",
    "fjaðurhamur dundi,",
    "uns fyr utan kom",
    "ása garða",
    "og fyr innan kom",
    "jötna heima."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þrymur sat á haugi,",
    "þursa drottinn,",
    "greyjum sínum",
    "gullbönd snöri",
    "og mörum sínum",
    "mön jafnaði."
   ]
  },
  {
   "t": "sp",
   "s": "Þrymur kvað:"
  },
  {
   "t": "v",
   "l": [
    "Hvað er með ásum?",
    "Hvað er með álfum?",
    "Hví ertu einn kominn",
    "í Jötunheima?"
   ]
  },
  {
   "t": "sp",
   "s": "Loki kvað:"
  },
  {
   "t": "p",
   "s": "Illt er með ásum, illt er með álfum; hefir þú Hlórriða hamar um fólginn?"
  },
  {
   "t": "sp",
   "s": "Þrymur kvað:"
  },
  {
   "t": "v",
   "l": [
    "Eg hefi Hlórriða.",
    "hamar um fólginn",
    "átta röstum",
    "fyr jörð neðan.",
    "Hann engi maður",
    "aftur um heimtir",
    "nema færi mér",
    "Freyju að kvæn."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fló þá Loki,",
    "fjaðurhamur dundi,",
    "uns fyr utan kom",
    "jötna heima",
    "og fyr innan kom",
    "ása garða.",
    "Mætti hann Þór",
    "miðra garða",
    "og hann það orða",
    "alls fyrst um kvað:"
   ]
  },
  {
   "t": "v",
   "l": [
    "Hefir þú erindi",
    "sem erfiði?",
    "Segðu á lofti",
    "löng tíðindi.",
    "Oft sitjanda",
    "sögur um fallast",
    "og liggjandi",
    "lygi um bellir."
   ]
  },
  {
   "t": "sp",
   "s": "Loki kvað:"
  },
  {
   "t": "v",
   "l": [
    "Hefi eg erfiði",
    "og erindi.",
    "Þrymur hefir þinn hamar,",
    "þursa drottinn.",
    "Hann engi maður",
    "aftur um heimtir",
    "nema honum færi",
    "Freyju að kvon."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ganga þeir fagra",
    "Freyju að hitta",
    "og hann það orða",
    "alls fyrst um kvað:",
    "Bittu þig, Freyja,",
    "brúðar líni;",
    "við skulum aka tvö",
    "í Jötunheima."
   ]
  },
  {
   "t": "v",
   "l": [
    "Reið varð þá Freyja",
    "og fnásaði,",
    "allur ása salur",
    "undir bifðist,",
    "stökk það hið mikla",
    "men Brísinga:",
    "Mig veistu verða",
    "vergjarnasta",
    "ef eg ek með þér",
    "í Jötunheima."
   ]
  },
  {
   "t": "v",
   "l": [
    "Senn voru æsir",
    "allir á þingi",
    "og ásynjur",
    "allar á máli",
    "og um það réðu",
    "ríkir tívar",
    "hve þeir Hlórriða",
    "hamar um sætti."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kvað það Heimdallur,",
    "hvítastur ása,",
    "vissi hann vel fram",
    "sem vanir aðrir:",
    "Bindum vér Þór þá",
    "brúðar líni,",
    "hafi hann ið mikla",
    "men Brísinga."
   ]
  },
  {
   "t": "v",
   "l": [
    "Látum und honum",
    "hrynja lukla",
    "og kvenvoðir",
    "um kné falla",
    "en á brjósti",
    "breiða steina",
    "og haglega",
    "um höfuð typpum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kvað það Þór,",
    "þrúðugur ás:",
    "Mig munu æsir",
    "argan kalla",
    "ef eg bindast læt",
    "brúðar líni."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kvað það Loki",
    "Laufeyjar sonur:",
    "Þegi þú, Þór,",
    "þeirra orða.",
    "Þegar munu jötnar",
    "Ásgarð búa",
    "nema þú þinn hamar",
    "þér um heimtir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Bundu þeir Þór þá",
    "brúðar líni",
    "og inu mikla",
    "meni Brísinga,",
    "létu und honum",
    "hrynja lukla",
    "og kvenvoðir",
    "um kné falla",
    "en á brjósti",
    "breiða steina",
    "og haglega",
    "um höfuð typptu."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kvað Loki",
    "Laufeyjar sonur:",
    "Mun eg og með þér",
    "ambátt vera,",
    "við skulum aka tvö",
    "í Jötunheima."
   ]
  },
  {
   "t": "v",
   "l": [
    "Senn voru hafrar",
    "heim um reknir,",
    "skyndir að sköklum,",
    "skyldu vel renna.",
    "Björg brotnuðu,",
    "brann jörð loga,",
    "ók Óðins sonur",
    "í Jötunheima."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kvað það Þrymur,",
    "þursa drottinn:",
    "Standið upp, jötnar,",
    "og stráið bekki.",
    "Nú færið mér",
    "Freyju að kvon",
    "Njarðar dóttur",
    "úr Nóatúnum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ganga hér að garði",
    "gullhyrndar kýr,",
    "öxn alsvartir",
    "jötni að gamni;",
    "fjöld á eg meiðma,",
    "fjöld á eg menja,",
    "einnar mér Freyju",
    "ávant þykir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Var þar að kveldi",
    "um komið snemma",
    "og fyr jötna",
    "öl fram borið.",
    "Einn át uxa,",
    "átta laxa,",
    "krásir allar",
    "þær er konur skyldu,",
    "drakk Sifjar ver",
    "sáld þrjú mjaðar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kvað það Þrymur,",
    "þursa drottinn:",
    "Hvar sáttu brúðir",
    "bíta hvassara?",
    "Sák-a eg brúðir",
    "bíta breiðara",
    "né inn meira mjöð",
    "mey um drekka."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sat in alsnotra",
    "ambátt fyrir",
    "er orð um fann",
    "við jötuns máli:",
    "Át vætur Freyja",
    "átta nóttum,",
    "svo var hún óðfús",
    "í Jötunheima."
   ]
  },
  {
   "t": "v",
   "l": [
    "Laut und línu,",
    "lysti að kyssa,",
    "en hann utan stökk",
    "endlangan sal:",
    "Hví eru öndótt",
    "augu Freyju?",
    "Þykir mér úr augum",
    "eldur um brenna."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sat in alsnotra",
    "ambátt fyrir",
    "er orð um fann",
    "við jötuns máli:",
    "Svaf vætur Freyja",
    "átta nóttum,",
    "svo var hún óðfús",
    "í Jötunheima."
   ]
  },
  {
   "t": "v",
   "l": [
    "Inn kom in arma",
    "jötna systir,",
    "hin er brúðfjár",
    "biðja þorði:",
    "Láttu þér af höndum",
    "hringa rauða,",
    "ef þú öðlast vilt",
    "ástir mínar,",
    "ástir mínar,",
    "alla hylli."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kvað það Þrymur,",
    "þursa drottinn:",
    "Berið inn hamar",
    "brúði að vígja,",
    "leggið Mjöllni",
    "í meyjar kné,",
    "vígið okkur saman",
    "Várar hendi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Hló Hlórriða",
    "hugur í brjósti",
    "er harðhugaður",
    "hamar um þekkti;",
    "Þrym drap hann fyrstan,",
    "þursa drottin,",
    "og ætt jötuns",
    "alla lamdi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Drap hann ina öldnu",
    "jötna systur,",
    "hin er brúðfjár",
    "um beðið hafði,",
    "hún skell um hlaut",
    "fyr skillinga,",
    "en högg hamars",
    "fyr hringa fjöld.",
    "Svo kom Óðins sonur",
    "endur að hamri."
   ]
  },
  {
   "t": "p",
   "s": "Netútgáfan janúar 1997"
  },
  {
   "t": "p",
   "s": "Þrymskviða er frá Runeberg samtökunum í Svíþjóð. (http://www.runeberg.lysator.liu.se)"
  }
 ]
}