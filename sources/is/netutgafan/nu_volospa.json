{
 "title": "",
 "edition_note": "Netútgáfan janúar 1997",
 "units": [
  {
   "t": "v",
   "l": [
    "Hljóðs bið eg allar",
    "helgar kindir,",
    "meiri og minni",
    "mögu Heimdallar.",
    "Viltu að eg, Valföður,",
    "vel fyr telja",
    "forn spjöll fira,",
    "þau er fremst um man."
   ]
  },
  {
   "t": "v",
   "l": [
    "Eg man jötna",
    "ár um borna,",
    "þá er forðum mig",
    "fædda höfðu.",
    "Níu man eg heima,",
    "níu íviði,",
    "mjötvið mæran",
    "fyr mold neðan."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ár var alda,",
    "það er ekki var,",
    "var-a sandur né sær",
    "né svalar unnir;",
    "jörð fannst æva",
    "né upphiminn,",
    "gap var ginnunga",
    "en gras hvergi,"
   ]
  },
  {
   "t": "v",
   "l": [
    "áður Burs synir",
    "bjöðum um ypptu,",
    "þeir er Miðgarð",
    "mæran skópu;",
    "sól skein sunnan",
    "á salar steina,",
    "þá var grund gróin",
    "grænum lauki."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sól varp sunnan,",
    "sinni mána,",
    "hendi inni hægri",
    "um himinjöður;",
    "sól það né vissi",
    "hvar hún sali átti,",
    "stjörnur það né vissu",
    "hvar þær staði áttu,",
    "máni það né vissi",
    "hvað hann megins átti."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá gengu regin öll",
    "á rökstóla,",
    "ginnheilög goð,",
    "og um það gættust;",
    "nótt og niðjum",
    "nöfn um gáfu,",
    "morgun hétu",
    "og miðjan dag,",
    "undorn og aftan,",
    "árum að telja."
   ]
  },
  {
   "t": "v",
   "l": [
    "Hittust æsir",
    "á Iðavelli,",
    "þeir er hörg og hof",
    "hátimbruðu;",
    "afla lögðu,",
    "auð smíðuðu,",
    "tangir skópu",
    "og tól gerðu."
   ]
  },
  {
   "t": "v",
   "l": [
    "Tefldu í túni,",
    "teitir vóru,",
    "var þeim vettergis",
    "vant úr gulli,",
    "uns þrjár kómu",
    "þursa meyjar",
    "ámáttkar mjög",
    "úr Jötunheimum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá gengu regin öll",
    "á rökstóla,",
    "ginnheilög goð,",
    "og um það gættust,",
    "hver skyldi dverga",
    "dróttir skepja",
    "úr Brimis blóði",
    "og úr Bláins leggjum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þar var Mótsognir",
    "mæstur um orðinn",
    "dverga allra,",
    "en Durinn annar;",
    "þeir mannlíkun",
    "mörg um gerðu",
    "dvergar úr jörðu,",
    "sem Durinn sagði."
   ]
  },
  {
   "t": "v",
   "l": [
    "Nýi og Niði,",
    "Norðri og Suðri,",
    "Austri og Vestri,",
    "Alþjófur, Dvalinn,",
    "Bívör, Bávör,",
    "Bömbur, Nóri,",
    "Án og Ánar,",
    "Ái, Mjöðvitnir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Veigur og Gandálfur,",
    "Vindálfur, Þráinn,",
    "Þekkur og Þorinn,",
    "Þrár, Vitur og Litur,",
    "Nár og Nýráður,",
    "nú hefi eg dverga,",
    "- Reginn og Ráðsviður, -",
    "rétt um talda."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fíli, Kíli,",
    "Fundinn, Náli,",
    "Hefti, Víli,",
    "Hannar, Svíur,",
    "Frár, Hornbori,",
    "Frægur og Lóni,",
    "Aurvangur, Jari,",
    "Eikinskjaldi."
   ]
  },
  {
   "t": "v",
   "l": [
    "Mál er dverga",
    "í Dvalins liði",
    "ljóna kindum",
    "til Lofars telja,",
    "þeir er sóttu",
    "frá salar steini",
    "Aurvanga sjöt",
    "til Jöruvalla."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þar var Draupnir",
    "og Dólgþrasir,",
    "Hár, Haugspori,",
    "Hlévangur, Glói,",
    "Skirvir, Virvir,",
    "Skáfiður, Ái."
   ]
  },
  {
   "t": "v",
   "l": [
    "Álfur og Yngvi,",
    "Eikinskjaldi,",
    "Fjalar og Frosti,",
    "Finnur og Ginnar;",
    "það mun upp",
    "meðan öld lifir,",
    "langniðja tal",
    "Lofars hafað."
   ]
  },
  {
   "t": "v",
   "l": [
    "Uns þrír kómu",
    "úr því liði",
    "öflgir og ástkir",
    "æsir að húsi,",
    "fundu á landi",
    "lítt megandi",
    "Ask og Emblu",
    "örlöglausa."
   ]
  },
  {
   "t": "v",
   "l": [
    "Önd þau né áttu,",
    "óð þau né höfðu,",
    "lá né læti",
    "né litu góða;",
    "önd gaf Óðinn,",
    "óð gaf Hænir,",
    "lá gaf Lóður",
    "og litu góða."
   ]
  },
  {
   "t": "v",
   "l": [
    "Ask veit eg standa,",
    "heitir Yggdrasill,",
    "hár baðmur, ausinn",
    "hvíta auri;",
    "þaðan koma döggvar",
    "þær er í dala falla,",
    "stendur æ yfir grænn",
    "Urðarbrunni."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þaðan koma meyjar",
    "margs vitandi",
    "þrjár úr þeim sæ,",
    "er und þolli stendur;",
    "Urð hétu eina,",
    "aðra Verðandi,",
    "skáru á skíði,",
    "Skuld ina þriðju.",
    "Þær lög lögðu,",
    "þær líf kuru",
    "alda börnum,",
    "örlög seggja."
   ]
  },
  {
   "t": "v",
   "l": [
    "Það man hún fólkvíg",
    "fyrst í heimi,",
    "er Gullveigu",
    "geirum studdu",
    "og í höll Hárs",
    "hana brenndu,",
    "þrisvar brenndu,",
    "þrisvar borna,",
    "oft, ósjaldan;",
    "þó hún enn lifir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Heiði hana hétu",
    "hvar er til húsa kom,",
    "völu velspáa,",
    "vitti hún ganda;",
    "seið hún hvar er hún kunni,",
    "seið hún hugleikin,",
    "æ var hún angan",
    "illrar brúðar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá gengu regin öll",
    "á rökstóla,",
    "ginnheilög goð,",
    "og um það gættust",
    "hvort skyldu æsir",
    "afráð gjalda",
    "eða skyldu goðin öll",
    "gildi eiga."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fleygði Óðinn",
    "og í fólk um skaut,",
    "það var enn fólkvíg",
    "fyrst í heimi;",
    "brotinn var borðveggur",
    "borgar ása,",
    "knáttu vanir vígspá",
    "völlu sporna."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá gengu regin öll",
    "á rökstóla,",
    "ginnheilög goð,",
    "og um það gættust",
    "hverjir hefði loft allt",
    "lævi blandið",
    "eða ætt jötuns",
    "Óðs mey gefna."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þór einn þar vó",
    "þrunginn móði,",
    "hann sjaldan situr",
    "er hann slíkt um fregn.",
    "Á gengust eiðar,",
    "orð og særi,",
    "mál öll meginleg",
    "er á meðal fóru."
   ]
  },
  {
   "t": "v",
   "l": [
    "Veit hún Heimdallar",
    "hljóð um fólgið",
    "undir heiðvönum",
    "helgum baðmi;",
    "á sér hún ausast",
    "aurgum fossi",
    "af veði Valföðurs.",
    "Vituð ér enn eða hvað?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Ein sat hún úti",
    "þá er inn aldni kom",
    "yggjungur ása",
    "og í augu leit:",
    "Hvers fregnið mig?",
    "Hví freistið mín?",
    "Allt veit eg, Óðinn,",
    "hvar þú auga falt,",
    "í inum mæra",
    "Mímisbrunni.",
    "Drekkur mjöð Mímir",
    "morgun hverjan",
    "af veði Valföðurs.",
    "Vituð ér enn eða hvað?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Valdi henni Herföður",
    "hringa og men,",
    "fékk spjöll spakleg",
    "og spá ganda,",
    "sá hún vítt og um vítt",
    "um veröld hverja."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sá hún valkyrjur",
    "vítt um komnar,",
    "görvar að ríða",
    "til Goðþjóðar;",
    "Skuld hélt skildi,",
    "en Skögul önnur,",
    "Gunnur, Hildur, Göndul",
    "og Geirskögul.",
    "Nú eru taldar",
    "nönnur Herjans,",
    "görvar að ríða",
    "grund valkyrjur."
   ]
  },
  {
   "t": "v",
   "l": [
    "Eg sá Baldri,",
    "blóðgum tívur,",
    "Óðins barni,",
    "örlög fólgin;",
    "stóð um vaxinn",
    "völlum hærri",
    "mjór og mjög fagur",
    "mistilteinn."
   ]
  },
  {
   "t": "v",
   "l": [
    "Varð af þeim meiði,",
    "er mær sýndist,",
    "harmflaug hættleg,",
    "Höður nam skjóta.",
    "Baldurs bróðir var",
    "um borinn snemma,",
    "sá nam Óðins sonur",
    "einnættur vega."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þó hann æva hendur",
    "né höfuð kembdi,",
    "áður á bál um bar",
    "Baldurs andskota;",
    "en Frigg um grét",
    "í Fensölum",
    "vá Valhallar.",
    "Vituð ér enn eða hvað?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kná Váli",
    "vígbönd snúa,",
    "heldur voru harðger",
    "höft úr þörmum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Haft sá hún liggja",
    "undir Hveralundi,",
    "lægjarns líki",
    "Loka áþekkjan.",
    "Þar situr Sigyn",
    "þeygi um sínum",
    "ver vel glýjuð.",
    "Vituð ér enn eða hvað?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Á fellur austan",
    "um eiturdala",
    "söxum og sverðum,",
    "Slíður heitir sú."
   ]
  },
  {
   "t": "v",
   "l": [
    "Stóð fyr norðan",
    "á Niðavöllum",
    "salur úr gulli",
    "Sindra ættar;",
    "en annar stóð",
    "á Ókólni",
    "bjórsalur jötuns,",
    "en sá Brimir heitir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sal sá hún standa",
    "sólu fjarri",
    "Náströndu á,",
    "norður horfa dyr.",
    "Féllu eiturdropar",
    "inn um ljóra,",
    "sá er undinn salur",
    "orma hryggjum."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sá hún þar vaða",
    "þunga strauma",
    "menn meinsvara",
    "og morðvarga",
    "og þann er annars glepur",
    "eyrarúnu.",
    "Þar saug Niðhöggur",
    "nái framgengna,",
    "sleit vargur vera.",
    "Vituð ér enn eða hvað?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Austur sat in aldna",
    "í Járnviði",
    "og fæddi þar",
    "Fenris kindir.",
    "Verður af þeim öllum",
    "einna nokkur",
    "tungls tjúgari",
    "í trölls hami."
   ]
  },
  {
   "t": "v",
   "l": [
    "Fyllist fjörvi",
    "feigra manna,",
    "rýður ragna sjöt",
    "rauðum dreyra.",
    "Svört verða sólskin",
    "um sumur eftir,",
    "veður öll válynd.",
    "Vituð ér enn eða hvað?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Sat þar á haugi",
    "og sló hörpu",
    "gýgjar hirðir,",
    "glaður Eggþér;",
    "gól um honum",
    "í galgviði",
    "fagurrauður hani,",
    "sá er Fjalar heitir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Gól um ásum",
    "Gullinkambi,",
    "sá vekur hölda",
    "að Herjaföðurs;",
    "en annar gelur",
    "fyr jörð neðan",
    "sótrauður hani",
    "að sölum Heljar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Geyr Garmur mjög",
    "fyr Gnipahelli,",
    "festur mun slitna",
    "en freki renna.",
    "Fjöld veit hún fræða,",
    "fram sé eg lengra",
    "um ragnarök",
    "römm sigtíva."
   ]
  },
  {
   "t": "v",
   "l": [
    "Bræður munu berjast",
    "og að bönum verðast,",
    "munu systrungar",
    "sifjum spilla;",
    "hart er í heimi,",
    "hórdómur mikill,",
    "skeggöld, skálmöld,",
    "skildir eru klofnir,",
    "vindöld, vargöld,",
    "áður veröld steypist,",
    "mun engi maður",
    "öðrum þyrma."
   ]
  },
  {
   "t": "v",
   "l": [
    "Leika Míms synir,",
    "en mjötuður kyndist",
    "að inu galla",
    "Gjallarhorni.",
    "Hátt blæs Heimdallur,",
    "horn er á lofti,",
    "mælir Óðinn",
    "við Míms höfuð."
   ]
  },
  {
   "t": "v",
   "l": [
    "Skelfur Yggdrasils",
    "askur standandi,",
    "ymur ið aldna tré,",
    "en jötunn losnar.",
    "Hræðast allir",
    "á helvegum",
    "áður Surtar þann",
    "sefi um gleypir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Hvað er með ásum?",
    "Hvað er með álfum?",
    "Gnýr allur Jötunheimur,",
    "æsir eru á þingi,",
    "stynja dvergar",
    "fyr steindurum,",
    "veggbergs vísir.",
    "Vituð ér enn eða hvað?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Geyr nú Garmur mjög",
    "fyr Gnipahelli,",
    "festur mun slitna",
    "en freki renna,",
    "fjöld veit hún fræða,",
    "fram sé eg lengra",
    "um ragnarök",
    "römm sigtíva."
   ]
  },
  {
   "t": "v",
   "l": [
    "Hrymur ekur austan,",
    "hefist lind fyrir,",
    "snýst Jörmungandur",
    "í jötunmóði.",
    "Ormur knýr unnir,",
    "en ari hlakkar,",
    "slítur nái Niðfölur,",
    "Naglfar losnar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Kjóll fer austan,",
    "koma munu Múspells",
    "um lög lýðir,",
    "en Loki stýrir.",
    "Fara fíflmegir",
    "með freka allir,",
    "þeim er bróðir",
    "Býleists í för."
   ]
  },
  {
   "t": "v",
   "l": [
    "Surtur fer sunnan",
    "með sviga lævi,",
    "skín af sverði",
    "sól valtíva.",
    "Grjótbjörg gnata,",
    "en gífur rata,",
    "troða halir helveg",
    "en himinn klofnar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kemur Hlínar",
    "harmur annar fram,",
    "er Óðinn fer",
    "við úlf vega,",
    "en bani Belja",
    "bjartur að Surti;",
    "þá mun Friggjar",
    "falla angan."
   ]
  },
  {
   "t": "v",
   "l": [
    "Geyr nú Garmur mjög",
    "fyr Gnipahelli,",
    "festur mun slitna,",
    "en freki renna."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kemur inn mikli",
    "mögur Sigföður,",
    "Víðar, vega",
    "að valdýri.",
    "Lætur hann megi Hveðrungs",
    "mundum standa",
    "hjör til hjarta,",
    "þá er hefnt föður."
   ]
  },
  {
   "t": "v",
   "l": [
    "Gín loft yfir",
    "lindi jarðar.",
    "Gapa ýgs kjaftar",
    "orms í hæðum.",
    "Mun Óðins son",
    "eitri mæta",
    "vargs að dauða",
    "Víðars niðja."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kemur inn mæri",
    "mögur Hlóðynjar,",
    "gengur Óðins sonur",
    "við orm vega,",
    "drepur hann af móði",
    "Miðgarðs véur,",
    "munu halir allir",
    "heimstöð ryðja;",
    "gengur fet níu",
    "Fjörgynjar bur",
    "neppur frá naðri",
    "níðs ókvíðinn."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sól tér sortna,",
    "sígur fold í mar,",
    "hverfa af himni",
    "heiðar stjörnur.",
    "Geisar eimi",
    "við aldurnara,",
    "leikur hár hiti",
    "við himin sjálfan."
   ]
  },
  {
   "t": "v",
   "l": [
    "Geyr nú Garmur mjög",
    "fyr Gnipahelli,",
    "festur mun slitna",
    "en freki renna."
   ]
  },
  {
   "t": "v",
   "l": [
    "Sér hún upp koma",
    "öðru sinni",
    "jörð úr ægi",
    "iðjagræna.",
    "Falla fossar,",
    "flýgur örn yfir,",
    "sá er á fjalli",
    "fiska veiðir."
   ]
  },
  {
   "t": "v",
   "l": [
    "Finnast æsir",
    "á Iðavelli",
    "og um moldþinur",
    "máttkan dæma",
    "og minnast þar",
    "á megindóma",
    "og á Fimbultýs",
    "fornar rúnar."
   ]
  },
  {
   "t": "v",
   "l": [
    "Þar munu eftir",
    "undursamlegar",
    "gullnar töflur",
    "í grasi finnast,",
    "þær er í árdaga",
    "áttar höfðu."
   ]
  },
  {
   "t": "v",
   "l": [
    "Munu ósánir",
    "akrar vaxa,",
    "böls mun alls batna,",
    "Baldur mun koma.",
    "Búa þeir Höður og Baldur",
    "Hrofts sigtóftir",
    "vel valtívar.",
    "Vituð ér enn eða hvað?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Þá kná Hænir",
    "hlautvið kjósa",
    "og burir byggja",
    "bræðra tveggja",
    "vindheim víðan.",
    "Vituð ér enn eða hvað?"
   ]
  },
  {
   "t": "v",
   "l": [
    "Sal sér hún standa",
    "sólu fegra,",
    "gulli þaktan",
    "á Gimlé.",
    "Þar skulu dyggvar",
    "dróttir byggja",
    "og um aldurdaga",
    "yndis njóta."
   ]
  },
  {
   "t": "v",
   "l": [
    "(Þá kemur inn ríki",
    "að regindómi",
    "öflugur ofan,",
    "sá er öllu ræður.)"
   ]
  },
  {
   "t": "v",
   "l": [
    "Þar kemur inn dimmi",
    "dreki fljúgandi,",
    "naður fránn, neðan",
    "frá Niðafjöllum;",
    "ber sér í fjöðrum,",
    "flýgur völl yfir,",
    "Niðhöggur nái.",
    "Nú mun hún sökkvast."
   ]
  }
 ]
