#!/bin/sh
# Runs before every push: no direct or forced push to main, and the pushed commits are scanned.
py=""
for c in python3.11 python3 python; do
  if command -v "$c" >/dev/null 2>&1; then py="$c"; break; fi
done
[ -n "$py" ] || { echo "pre-push: no Python found; cannot run scripts/check_public.py" >&2; exit 1; }
zero=0000000000000000000000000000000000000000
rc=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue                      # deleting a remote branch
  case "$rref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: no direct push to $rref; open a pull request." >&2; rc=1; continue ;;
  esac
  if [ "$rsha" = "$zero" ]; then
    base=$(git merge-base "$lsha" refs/remotes/origin/main 2>/dev/null) || base=""
    if [ -n "$base" ]; then range="$base..$lsha"; else range="$lsha"; fi
  else
    if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
      echo "pre-push: $rref would be rewritten (forced push). Not on a public repository." >&2; rc=1; continue
    fi
    range="$rsha..$lsha"
  fi
  "$py" -I scripts/check_public.py --range "$range" || rc=1
done
exit $rc
