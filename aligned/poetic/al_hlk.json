     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": []
    },
    {
     "id": "hlk-p3",
     "stanza": null,
     "on": [
      {
       "t": "p",
       "s": "Hlöðr reiddist nú mjök, er hann var þýbarn ok hornungr kallaðr, ef hann þægi boð bróður síns, ok sneri hann þá þegar í burt með alla sína menn, til þess er hann kom heim í Húnaland til Humla konungs, frænda síns, ok sagði honum, at Angantýr, bróðir hans, hefði synjat honum helmingaskiptis. Humli spyrr nú allt tal þeira. Varð hann þá reiðr mjök, ef Hlöðr, dóttursonr hans, skyldi ambáttarsonr heita, ok kvað þá:"
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hlöður reiddist nú mjög, er hann var þýbarn og hornungur kallaður, ef hann þægi boð bróður síns, og sneri hann þá þegar í burt með alla sína menn, til þess er hann kom heim í Húnaland til Humla konungs, frænda síns, og sagði honum, að Angantýr, bróðir hans, hefði synjað honum helmingaskiptis. Humli spyr nú allt tal þeirra. Varð hann þá reiður mjög, ef Hlöður, dóttursonur hans, skyldi ambáttarsonur heita, og kvað þá:"
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": []
    },
    {
     "id": "hlk-s16",
     "stanza": 16,
     "on": [
      {
       "t": "v",
       "n": 16,
       "l": [
        "\"Sitja skulu vér í vetr",
        "ok sælliga lifa,",
        "drekka ok dæma",
        "dýrar veigar,",
        "kenna Húnum",
        "hervápn búa,",
        "þau er fræknliga",
        "skulum fram bera."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 16,
       "l": [
        "\"Sitja skulu vér í vetur",
        "og sællega lifa,",
        "drekka og dæma",
        "dýrar veigar,",
        "kenna Húnum",
        "hervápn búa,",
        "þau er fræknlega",
        "skulum fram bera."
       ]
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": []
    },
