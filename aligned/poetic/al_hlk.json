     "stanza": 17,
     "on": [
      {
       "t": "v",
       "n": 17,
       "l": [
        "Vel skulum þér, Hlöðr,",
        "herlið búa",
        "ok framliga",
        "fylki týja;",
        "með tolf vetra mengi",
        "ok tvævetrum fola,",
        "svá skal Húna",
        "her of samna.\""
       ]
      }
     ],
     "is": [
