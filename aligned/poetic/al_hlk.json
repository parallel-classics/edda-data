        "risu með góðum;",
        "vildi hver heyra,",
        "hvað Hlöður mælti",
        "og það, er Angantýr",
        "andsvör veitti."
       ]
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": []
    },
    {
     "id": "hlk-s7",
     "stanza": 7,
     "on": [
      {
       "t": "p",
       "s": "Þá mælti Angantýr:",
       "sp": true
      },
      {
       "t": "v",
       "n": 7,
       "l": [
        "\"Heill kom þú, Hlöðr,",
        "Heiðreks arfi,",
        "bróðir minn,",
        "gakk á bekk sitja;",
        "drekkum Heiðreks",
        "hollar veigar",
        "feðr okkrum",
        "fyrstum manna,",
        "vín eða mjöð,",
        "hvárts þér vildra þykkir.\""
       ]
      }
     ],
     "is": [
