       "t": "p",
       "s": "Þá kvað Hlöðr:",
       "sp": true
      },
      {
       "t": "v",
       "n": 8,
       "l": [
        "\"Til annars vér",
        "en öl at drekka",
        "hingat fórum",
        "[af Húna landi]",
        "þigg-a-k, þjóðann,",
        "þínar veigar."
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Þá kvað Hlöður:",
