        "hin blikhvíta lind",
        "og kaldur geir",
        "koma við annan",
        "og margur gumi",
        "í gras hníga,",
        "áður en Tyrfing",
        "í tvö deilak",
        "eða þér, Humlungur,",
        "hálfan arf látak."
       ]
      },
      {
       "t": "v",
       "n": null,
       "l": [
