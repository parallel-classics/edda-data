    {
     "id": "hlk-s2",
     "stanza": 2,
     "on": [
      {
       "t": "v",
       "n": 2,
       "l": [
        "Hlöðr var þar borinn",
        "í Húnalandi",
        "saxi ok með sverði,",
        "síðri brynju,",
        "hjalmi hringreifðum,",
        "hvössum mæki,",
        "mari vel tömum",
        "á mörk inni helgu."
       ]
      }
     ],
     "is": [
