       "t": "v",
       "n": 4,
       "l": [
        "Segg fann hann úti",
        "fyr sal hávum",
        "ok síðförlan",
        "síðan kvaddi?",
        "\"Inn gakktu, seggr,",
        "í sal hávan,",
        "bið mér Angantý",
        "andspjöll bera.\""
       ]
      }
     ],
