     "stanza": null,
     "on": [
      {
       "t": "p",
       "s": "Sá gekk inn fyrir konungs borð ok kvaddi Angantý konung vel ok mælti síðan:"
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Sá gekk hinn fyrir konungs borð og kvaddi Angantý konung vel og mælti síðan:"
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": []
    },
    {
     "id": "hlk-s5",
     "stanza": 5,
     "on": [
      {
       "t": "v",
       "n": 5,
       "l": [
        "\"Hér er Hlöðr kominn,",
        "Heiðreks arfþegi,",
        "bróðir þinn",
        "inn böðskái;",
        "mikill er sá maðr ungr",
        "á mars baki,",
        "vill nú, þjóðann,",
        "við þik tala.\""
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 5,
       "l": [
        "\"Hér er Hlöður kominn,",
        "Heiðreks arfþegi,",
        "bróðir þinn",
        "hinn böðskái;",
        "mikill er sá maður ungur",
        "á mars baki,",
        "vill nú, þjóðann,",
        "við þig tala.\""
       ]
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": []
    },
    {
     "id": "hlk-s6",
     "stanza": 6,
     "on": [
      {
       "t": "v",
       "n": 6,
       "l": [
        "Rymr varð í ranni,",
        "risu með góðum;",
        "vildi hverr heyra,",
        "hvat Hlöðr mælti",
        "ok þat, er Angantýr",
        "andsvör veitti."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
