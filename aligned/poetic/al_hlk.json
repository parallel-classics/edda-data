     "stanza": 13,
     "on": [
      {
       "t": "v",
       "n": 13,
       "l": [
        "Manni gef ek hverjum",
        "margt at þiggja",
        "annat æðra",
        "en hann á at ráða;",
        "mey gef ek hverjum",
        "manni at þiggja,",
        "men spenni ek hverri",
        "meyju at halsi."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 13,
       "l": [
        "Manni gef eg hverjum",
        "margt að þiggja",
        "annað æðra",
        "en hann á að ráða;",
        "mey gef eg hverjum",
        "manni að þiggja,",
        "men spenni eg hverri",
