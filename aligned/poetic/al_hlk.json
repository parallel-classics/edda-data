     "stanza": 3,
     "on": [
      {
       "t": "v",
       "n": 3,
       "l": [
        "Hlöðr reið austan,",
        "Heiðreks arfi;",
        "kom hann at garði,",
        "þar er Gotar byggja,",
        "á Árheima,",
        "arfs at kveðja;",
        "þar drakk Angantýr",
        "erfi Heiðreks."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
