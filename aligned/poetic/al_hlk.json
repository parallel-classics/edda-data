      {
       "t": "v",
       "n": 8,
       "l": [
        "\"Til annars vér",
        "en öl að drekka",
        "hingað fórum",
        "[af Húna landi]",
        "þigg-a-k, þjóðann,",
        "þínar veigar."
       ]
