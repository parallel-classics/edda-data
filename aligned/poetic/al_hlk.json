     "stanza": 14,
     "on": [
      {
       "t": "v",
       "n": 14,
       "l": [
        "Mun ek um þik sitjanda",
        "silfri mæla,",
        "en ganganda þik",
        "gulli steypa,",
        "svá at á vega alla",
        "velti baugar;",
        "þriðjung Goðþjóðar, -",
        "því skaltu ráða.\""
       ]
      }
     ],
     "is": [
