    {
     "id": "hlk-s1",
     "stanza": 1,
     "on": [
      {
       "t": "v",
       "n": 1,
       "l": [
        "Ár kváðu Humla",
        "Húnum ráða,",
        "Gizur Gautum,",
        "Gotum Angantý,",
        "Valdarr Dönum,",
        "en Völum Kíarr,",
        "Alrekr inn frækni",
        "enskri þjóðu."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
