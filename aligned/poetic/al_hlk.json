     "on": [
      {
       "t": "v",
       "n": 10,
       "l": [
        "Hrís þat it mæra,",
        "er Myrkvið heita,",
        "gröf þá ina helgu,",
        "er stendr á Goðþjóðu,",
        "stein þann inn fagra,",
        "er stendr á stöðum Danpar,",
        "halfar herborgir,",
        "þær er Heiðrekr átti,",
        "lönd ok lýða",
        "ok ljósa bauga.\""
       ]
      }
     ],
     "is": [
      {
