    {
     "id": "hlk-s11",
     "stanza": 11,
     "on": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 11,
       "l": [
        "\"Bresta mun fyrr, bróðir,",
        "in blikhvíta lind",
        "ok kaldr geirr",
        "koma við annan",
        "ok margr gumi",
        "í gras hníga,",
        "áðr en Tyrfing",
        "í tvau deilak",
        "eða þér, Humlungr,",
        "halfan arf látak."
       ]
      },
      {
       "t": "v",
       "n": null,
       "l": [
        "12",
        "Ek mun bjóða þér",
        "bjartar vigrar,",
        "fé ok fjölð meiðma,",
        "sem þik fremst tíðir;",
        "tolf hundruð gef ek þér manna,",
        "tolf huhdruð gef ek þér mara,",
        "tolf hundruð gef ek þér skálka,",
        "þeira er skjöld bera."
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 11,
       "l": [
