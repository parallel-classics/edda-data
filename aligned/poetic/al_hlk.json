        "Gotum Angantý,",
        "Valdar Dönum,",
        "en Völum Kíar,",
        "Alrekur hinn frækni",
        "enskri þjóðu."
       ]
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
