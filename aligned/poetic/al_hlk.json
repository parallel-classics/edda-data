       "t": "v",
       "n": 9,
       "l": [
        "Hafa vil ek halft allt,",
        "þat er Heiðrekr átti,",
        "al ok af oddi,",
        "einum skatti,",
        "kú ok af kalfi,",
        "kvern þjótandi,",
        "þý ok af þræli",
        "ok þeira barni;"
       ]
      }
