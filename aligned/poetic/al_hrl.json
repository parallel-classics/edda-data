     "stanza": 20,
     "on": [
      {
       "t": "v",
       "n": 20,
       "l": [
        "Snúizk snarliga,",
        "snyrtidrengir,",
        "út ór eldi",
        "með auðbrota.",
        "Engi er ýta,",
        "sá er æ lifir.",
