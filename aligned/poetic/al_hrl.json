       "s": "Innsteinn kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 3,
       "l": [
        "\"Sér eigi þú allan",
        "Ásmundar hug,",
        "hefir fylkir sá",
        "flærð í brjósti.",
        "Mundir þú, þengill,",
        "ef vér því réðim,",
        "mági þínum",
        "mjök lítt trúa.\""
       ]
      }
     ],
