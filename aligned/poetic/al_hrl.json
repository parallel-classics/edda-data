       "t": "v",
       "n": 22,
       "l": [
        "\"Hrókur er fallin",
        "með hertoga",
        "frækn að fótum",
        "fólks oddvita.",
        "Eigum Óðni",
        "illt að gjalda,",
        "er hann slíkan konung",
        "sigri rænti."
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "\"Hrókr has fallen",
        "with the war-leader,",
        "the bold one, at the feet",
        "of the people's commander.",
        "We have to repay Óðinn",
        "with ill,",
        "since he robbed such a king",
        "of victory."
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
