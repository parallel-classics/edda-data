       "s": "Innsteinn said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"Let the Hrókar listen,",
        "and the king's host,",
        "to my words,",
        "Útsteinn the third:",
        "let us all go",
        "up from the shore;",
        "we do not heed",
        "the king's word in this [?].\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
