     "stanza": 23,
     "on": [
      {
       "t": "v",
       "n": 23,
       "l": [
        "Ek hefi úti",
        "átján sumur",
        "fylgt fullhuga",
        "flein at rjóða.",
        "Skalk-at annan",
        "eiga dróttin",
        "gunnar gjarnan",
        "né gamall verða."
       ]
      }
     ],
     "is": [
