       "t": "p",
       "s": "Innsteinn kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 5,
       "l": [
        "\"Þér er orðinn",
        "Óðinn til gramr,",
        "er þú Ásmundi",
        "allvel trúir.",
        "Hann mun alla",
        "oss of véla,",
        "nema þú víti",
        "viðsjár fáir.\""
       ]
      }
     ],
     "is": [
