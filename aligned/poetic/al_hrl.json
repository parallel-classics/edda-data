      {
       "t": "v",
       "n": 4,
       "l": [
        "\"Ásmundr hefir",
        "oss of unnit",
        "margar tryggðir,",
        "sem menn vitu.",
        "Mun-at góðr konungr",
        "ganga á sáttir",
        "né gramr annan",
        "í griðum véla.\""
       ]
      }
     ],
     "is": [
