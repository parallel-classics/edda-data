      {
       "t": "v",
       "n": 2,
       "l": [
        "\"Vér skulum hálfir",
        "herjar þessa",
        "sáttir sækja",
        "frá sjó neðan.",
        "Ásmundr hefir",
        "oss of boðna",
        "hringa rauða",
        "sem hafa viljum.\""
       ]
      }
     ],
     "is": [
