      {
       "t": "v",
       "n": 7,
       "l": [
        "\"Hálfr, dreymði mik,",
        "- hyggðu at slíku, -",
        "at logi léki",
        "of liði váru,",
        "illt væri þar",
        "ór at leysask.",
        "Hvat kveðr þú, þengill,",
        "þann draum vita?\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Innsteinn kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 7,
       "l": [
        "\"Hálfur, dreymdi mig,",
        "- hyggðu að slíku, -",
        "að logi léki",
        "of liði voru,",
        "illt væri þar",
        "úr að leysast.",
        "Hvað kveður þú, þengill,",
        "þann draum vita?\""
       ]
      }
     ],
     "en": [],
