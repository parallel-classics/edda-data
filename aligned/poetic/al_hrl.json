      {
       "t": "v",
       "n": 6,
       "l": [
        "\"Æ lystir þik",
        "æðru at mæla,",
        "mun-at sá konungr",
        "sáttir rjúfa.",
        "Gull eigum þar",
        "ok gersimar,",
        "hringa rauða,",
        "frá hans búum.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Konungur kvað:",
