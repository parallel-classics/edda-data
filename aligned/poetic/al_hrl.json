       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"The ruler has relied,",
        "on voyages abroad,",
        "on my counsels",
        "many a time.",
        "Now I say he is not willing",
        "to heed anything",
        "that I speak,",
        "since we came here.\""
       ]
      }
