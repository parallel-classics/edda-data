        "til jarðar hníga",
        "horskr at höfði",
        "hers oddvita.",
        "Þat munu seggir",
        "at sögum gera,",
        "at Hálfr konungr",
        "hlæjandi dó.\""
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 24,
       "l": [
