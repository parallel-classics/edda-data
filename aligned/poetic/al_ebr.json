     ]
    },
    {
     "id": "ebr-s9",
     "stanza": 9,
     "on": [
      {
       "t": "v",
       "n": 9,
       "l": []
      },
      {
       "t": "p",
       "s": "Þessi eru hestaheiti í Þorgrímsþulu:",
       "sp": true
      },
      {
       "t": "v",
       "n": null,
       "l": [
        "Hrafn ok Sleipnir",
        "hestar ágætir,",
        "Valr ok Léttfeti,",
        "var þar Tjaldari,",
        "Gulltoppr ok Goti,",
        "getit heyrðak Sóta,",
        "Mór ok Lungr með Mari."
       ]
      },
      {
       "t": "v",
       "n": null,
       "l": [
        "Vigg ok Stúfr",
        "var með Skævaði,",
        "þegn knátti Blakkr bera,",
        "Silfrintoppr ok Sinir,",
