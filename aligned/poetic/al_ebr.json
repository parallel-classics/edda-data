    },
    {
     "id": "ebr-p16",
     "stanza": null,
     "on": [
      {
       "t": "p",
       "s": "Í Ásgarði fyrir dyrum Valhallar stendr lundr, sá er glasi er kallaðr, en lauf hans allt er gull rautt, svá sem hér er kveðit, at:"
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Í Ásgarði fyrir dyrum Valhallar stendur lundur, sá er glasi er kallaður, en lauf hans allt er gull rautt, svo sem hér er kveðið, að:"
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": []
    },
    {
     "id": "ebr-p17",
     "stanza": null,
     "on": [
      {
       "t": "v",
       "n": null,
       "l": [
        "Glasir stendr",
        "með gullnu laufi",
        "fyrir Sigtýs sölum."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": null,
       "l": [
        "Glasir stendur",
        "með gullnu laufi",
        "fyrir Sigtýs sölum."
       ]
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
