     "stanza": null,
     "on": [
      {
       "t": "p",
       "s": "Hár segir, at hann (Gylfi) kom eigi heill út, nema hann sé fróðari, ok"
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hár segir, að hann (Gylfi) kom eigi heill út, nema hann sé fróðari, og"
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": []
    },
    {
     "id": "ebr-p2",
     "stanza": null,
     "on": [
      {
       "t": "v",
       "n": null,
       "l": [
        "\"Stattu fram,",
        "meðan þú fregn,",
        "sitja skal sá, er segir.\""
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": null,
       "l": [
        "\"Stattu fram,",
        "meðan þú fregn,",
        "sitja skal sá, er segir.\""
       ]
