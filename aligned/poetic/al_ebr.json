     "quoted_in": []
    },
    {
     "id": "ebr-p7",
     "stanza": null,
     "on": [
      {
       "t": "p",
       "s": "(In fjórtánda ásynja er) Gná. Hana sendir Frigg í ýmsa heima at erindum sínum. Hon á þann hest, er renn loft ok lög ok heitir Hófvarpnir. Þat var eitt sinn, er hon reið; at Vanir nökkurir sáu reið hennar í loftinu. Þá mælti einn:"
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "(Hin fjórtánda ásynja er) Gná. Hana sendir Frigg í ýmsa heima að erindum sínum. Hún á þann hest, er rennur loft og lög og heitir Hófvarpnir. Það var eitt sinn, er hún reið; að vanir nokkrir sáu reið hennar í loftinu. Þá mælti einn:"
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": []
    },
    {
     "id": "ebr-p8",
     "stanza": null,
     "on": [
      {
       "t": "v",
       "n": null,
       "l": [
        "\"Hvat þar flýgr,",
        "hvat þat ferr",
        "eða at lofti líðr?\""
       ]
      },
      {
       "t": "p",
       "s": "Hon svarar:",
       "sp": true
      },
      {
       "t": "v",
       "n": null,
       "l": [
        "\"Né ek flýg",
        "þó ek ferk",
        "ok at lofti líðk",
        "á Hófvarpni,",
        "þeim er Hamskerpir",
        "gat við Garðrofu.\""
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": null,
       "l": [
        "\"Hvað þar flýgur,",
        "hvað það fer",
        "eða að lofti líður?\""
       ]
      },
      {
       "t": "p",
       "s": "Hún svarar:",
       "sp": true
      },
      {
       "t": "v",
       "n": null,
       "l": [
        "\"Né eg flýg",
        "þó eg fer",
        "og að lofti líðk",
        "á Hófvarpni,",
        "þeim er Hamskerpir",
        "gat við Garðrofu.\""
       ]
      }
     ],
     "en": [],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [
      "g-c35-16",
      "g-c35-18"
     ]
    },
    {
     "id": "ebr-s5",
     "stanza": 5,
     "on": [
      {
       "t": "v",
       "n": 5,
       "l": []
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 5,
       "l": []
