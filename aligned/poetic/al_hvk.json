{
 "part": "poetic",
 "poem": "hvk",
 "title": "Hervararkviða",
 "group": "other",
 "chapters": [
  {
   "num": 39,
   "key": "hvk",
   "title": "Hervararkviða",
   "subtitle": null,
   "group": "other",
   "rows": [
    {
     "id": "hvk-s1",
     "stanza": 1,
     "on": [
      {
       "t": "v",
       "n": 1,
       "l": [
        "Hitt hefr mær ung",
        "í Munarvági",
        "við sólar setr",
        "segg at hjörðu."
       ]
      },
      {
       "t": "p",
       "s": "Hirðir kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": null,
       "l": [
        "\"Hverr er einn saman",
        "í ey kominn?",
        "Gakk þú greiðliga",
        "gistingar til!\""
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 1,
       "l": [
        "Hitt hefur mær ung",
        "í Munarvági",
        "við sólar setur",
        "segg að hjörðu."
       ]
      },
      {
       "t": "p",
       "s": "Hirðir kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": null,
       "l": [
        "\"Hver er einn saman",
        "í ey kominn?",
        "Gakk þú greiðlega",
        "gistingar til!\""
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "The young maiden met",
        "in Munarvágr,",
        "at the setting of the sun,",
        "a man with his herd."
       ]
      },
      {
       "t": "p",
       "s": "The herdsman said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"Who is it that has come",
        "alone to the island?",
        "Go quickly",
        "to find shelter!\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s2",
     "stanza": 2,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 2,
       "l": [
        "\"Muna-at ek ganga",
        "gistingar til,",
        "því at ek engi kann",
        "eyjaskeggja;",
        "segðu hraðliga,",
        "áðr heðan líðir:",
        "hvar eru Hjörvarði",
        "haugar kenndir?\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 2,
       "l": [
        "\"Muna-at eg ganga",
        "gistingar til,",
        "því að eg enginn kann",
        "eyjaskeggja;",
        "segðu hraðlega,",
        "áður héðan líðir:",
        "hvar eru Hjörvarði",
        "haugar kenndir?\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Hervör said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"I will not go",
        "to find shelter,",
        "for I know none",
        "of the islanders;",
        "tell me quickly,",
        "before you go hence:",
        "where are the mounds",
        "known as Hjörvarðr's?\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s3",
     "stanza": 3,
     "on": [
      {
       "t": "p",
       "s": "Hirðir kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 3,
       "l": [
        "\"Spyj-at-tu at því;",
        "spakr ertu eigi,",
        "vinr víkinga,",
        "ertu vanfarinn;",
        "förum fráliga,",
        "sem okkr fætr toga,",
        "allt er úti",
        "ámátt firum!\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hirðir kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 3,
       "l": [
        "\"Spyj-at-tu að því;",
        "spakur ertu eigi,",
        "vinur víkinga,",
        "ertu vanfarinn;",
        "förum frálega,",
        "sem okkur fætur toga,",
        "allt er úti",
        "ámátt firum!\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "The herdsman said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"Do not ask about that;",
        "you are not wise,",
        "friend of vikings,",
        "you are in a bad way;",
        "let us go swiftly",
        "as our feet will carry us,",
        "everything outside",
        "is dreadful for men!\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s4",
     "stanza": 4,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 4,
       "l": [
        "\"Men bjóðum þér",
        "máls at gjöldum;",
        "mun-a drengja vin",
        "dælt at letja:",
        "fær engi mér",
        "svá fríðar hnossir,",
        "fagra bauga,",
        "at ek fara eigi.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 4,
       "l": [
        "\"Men bjóðum þér",
        "máls að gjöldum;",
        "mun-a drengja vin",
        "dælt að letja:",
        "fær enginn mér",
        "svo fríðar hnossir,",
        "fagra bauga,",
        "að eg fara eigi.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Hervör said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"We offer you a necklace",
        "as payment for your speech;",
        "it will not be easy",
        "to hold back the friend of warriors:",
        "no one will give me",
        "such fine treasures,",
        "fair rings,",
        "that I would not go.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s5",
     "stanza": 5,
     "on": [
      {
       "t": "p",
       "s": "Hirðir kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 5,
       "l": [
        "\"Heimskr þykki mér,",
        "sá er heðra ferr",
        "maðr einn saman",
        "myrkvar grímur;",
        "hyrr er á sveimun,",
        "haugar opnask,",
        "brenn fold ok fen;",
        "förum harðara.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hirðir kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 5,
       "l": [
        "\"Heimskur þyki mér,",
        "sá er heðra fer",
        "maður einn saman",
        "myrkvar grímur;",
        "hyr er á sveimun,",
        "haugar opnast,",
        "brenn fold og fen;",
        "förum harðar.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "The herdsman said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"A fool he seems to me",
        "who comes here,",
        "a man alone,",
        "in the dark night-times;",
        "fire is hovering about,",
        "mounds are opening,",
        "earth and fen are burning;",
        "let us go faster.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s6",
     "stanza": 6,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 6,
       "l": [
        "\"Hirðum-at fælask",
        "við fnösun slíka,",
        "þótt um alla ey",
        "eldar brenni;",
        "látum okkr eigi",
        "liðna rekka",
        "skjótla skelfa,",
        "skulum við talask.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 6,
       "l": [
        "\"Hirðum-at fælast",
        "við fnösun slíka,",
        "þótt um alla ey",
        "eldar brenni;",
        "látum okkur eigi",
        "liðna rekka",
        "skjótla skelfa,",
        "skulum við talast.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Hervör said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"Let us not take fright",
        "at such snorting,",
        "even if over the whole island",
        "fires are burning;",
        "let us not let",
        "dead warriors",
        "quickly scare us;",
        "we two shall talk.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s7",
     "stanza": 7,
     "on": [
      {
       "t": "v",
       "n": 7,
       "l": [
        "Var þá féhirðir",
        "fljótr til skógar",
        "mjök frá máli",
        "meyjar þessar;",
        "en harðsnúinn",
        "hugr í brjósti",
        "um sakar slíkar",
        "svellr Hervöru."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 7,
       "l": [
        "Var þá féhirðir",
        "fljótur til skógar",
        "mjög frá máli",
        "meyjar þessar;",
        "en harðsnúinn",
        "hugur í brjósti",
        "um sakir slíkar",
        "svellur Hervöru."
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "Then the herdsman was",
        "swift to the forest,",
        "far from the speech",
        "of this maiden;",
        "but the hard-tempered",
        "mind in her breast",
        "at such things",
        "swells in Hervör."
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-p1",
     "stanza": null,
     "on": [
      {
       "t": "p",
       "s": "Hon sá nú haugeldana .... ok gengr til hauganna ok hræðist ekki, ok óð hon eldana sem reyk, þar til er hon kom at haugi berserkjanna. Þá kvað hon:"
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hún sá nú haugeldana .... og gengur til hauganna og hræðist ekki, og óð hún eldana sem reyg, þar til er hún kom að haugi berserkjanna. Þá kvað hún:"
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "She now saw the mound-fires …. and goes to the mounds and is not afraid, and she waded through the fires as through smoke, until she came to the mound of the berserks. Then she said:"
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s8",
     "stanza": 8,
     "on": [
      {
       "t": "v",
       "n": 8,
       "l": [
        "\"Vaki þú, Angantýr,",
        "vekr þik Hervör,",
        "eingadóttir",
        "ykkur Sváfu;",
        "sel þú mér ór haugi",
        "hvassan mæki,",
        "þann er Svafrlama",
        "slógu dvergar."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 8,
       "l": [
        "\"Vaki þú, Angantýr,",
        "vekur þig Hervör,",
        "eingadóttir",
        "ykkur Sváfu;",
        "sel þú mér úr haugi",
        "hvassan mæki,",
        "þann er Svafrlama",
        "slógu dvergar."
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "\"Wake, Angantýr,",
        "Hervör wakes you,",
        "the only daughter",
        "of you and Sváfa;",
        "give me from the mound",
        "the sharp sword",
        "which for Svafrlami",
        "the dwarfs forged."
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s9",
     "stanza": 9,
     "on": [
      {
       "t": "v",
       "n": 9,
       "l": [
        "Hervarðr, Hjörvarðr,",
        "Hrani, Angantýr!",
        "vek ek yðr alla",
        "undir viðar rótum,",
        "hjálmi ok með brynju,",
        "hvössu sverði,",
        "rönd ok með reiði,",
        "roðnum geiri."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 9,
       "l": [
        "Hervarður, Hjörvarður,",
        "Hrani, Angantýr!",
        "veg eg yður alla",
        "undir viðar rótum,",
        "hjálmi og með brynju,",
        "hvössu sverði,",
        "rönd og með reiði,",
        "roðnum geiri."
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "Hervarðr, Hjörvarðr,",
        "Hrani, Angantýr!",
        "I wake you all",
        "under the roots of the trees,",
        "with helmet and with mail-coat,",
        "with sharp sword,",
        "with shield and with harness,",
        "with reddened spear."
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s10",
     "stanza": 10,
     "on": [
      {
       "t": "v",
       "n": 10,
       "l": [
        "Mjök eruð orðnir",
        "Arngríms synir,",
        "megir meinsamir,",
        "at moldar auka,",
        "er engi skal",
        "sona Eyfuru",
        "við mik mæla",
        "í Munarvági."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 10,
       "l": [
        "Mjög eruð orðnir",
        "Arngríms synir,",
        "megir meinsamir,",
        "að moldar auka,",
        "er enginn skal",
        "sona Eyfuru",
        "við mig mæla",
        "í Munarvági."
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "Far gone you have become,",
        "sons of Arngrímr,",
        "harmful kinsmen,",
        "into an increase of the soil [?],",
        "when not one",
        "of Eyfura's sons",
        "will speak with me",
        "in Munarvágr."
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s11",
     "stanza": 11,
     "on": [
      {
       "t": "v",
       "n": 11,
       "l": [
        "Hervarðr, Hjörvarðr,",
        "Hrani, Angantýr!",
        "Svá sé yðr öllum",
        "innan rifja",
        "sem þér í maura",
        "mornið haugi,",
        "nema sverð selið,",
        "þar er sló Dvalinn;",
        "samir-a draugum",
        "dýrt vápn fela.\""
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 11,
       "l": [
        "Hervarður, Hjörvarður,",
        "Hrani, Angantýr!",
        "Svo sé yður öllum",
        "innan rifja",
        "sem þér í maura",
        "mornið haugi,",
        "nema sverð selið,",
        "þar er sló Dvalinn;",
        "samir-a draugum",
        "dýrt vopn fela.\""
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "Hervarðr, Hjörvarðr,",
        "Hrani, Angantýr!",
        "So may it be for you all",
        "within your ribs",
        "as if in an ants'",
        "heap you were rotting [?],",
        "unless you hand over the sword",
        "which Dvalinn forged;",
        "it does not befit ghosts",
        "to hide a precious weapon.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s12",
     "stanza": 12,
     "on": [
      {
       "t": "p",
       "s": "Þá svarar Angantýr:",
       "sp": true
      },
      {
       "t": "v",
       "n": 12,
       "l": [
        "\"Hervör dóttir,",
        "hví kallar svá?",
        "Full feiknstafa",
        "ferr þú þér at illu!",
        "Ær ertu orðin",
        "ok örvita,",
        "villhyggjandi,",
        "vekr menn dauða."
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Þá svarar Angantýr:",
       "sp": true
      },
      {
       "t": "v",
       "n": 12,
       "l": [
        "\"Hervör dóttir,",
        "hví kallar svo?",
        "Full feiknstafa",
        "fer þú þér að illu!",
        "Ær ertu orðin",
        "og örvita,",
        "villhyggjandi,",
        "vekur menn dauða."
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Then Angantýr answers:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"Hervör, daughter,",
        "why do you call so?",
        "Full of evil spells",
        "you go to your own harm!",
        "Mad you have become",
        "and out of your wits,",
        "with bewildered mind,",
        "you wake dead men."
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s13",
     "stanza": 13,
     "on": [
      {
       "t": "v",
       "n": 13,
       "l": [
        "Gróf-at mik faðir",
        "né frændr aðrir;",
        "þeir höfðu Tyrfing",
        "tveir, er lifðu;",
        "varð þó eigandi",
        "einn um síðir.\""
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 13,
       "l": [
        "Gróf-at mig faðir",
        "né frændur aðrir;",
        "þeir höfðu Tyrfing",
        "tveir, er lifðu;",
        "varð þó eigandi",
        "einn um síðir.\""
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "No father buried me",
        "nor other kinsmen;",
        "they had Tyrfingr,",
        "the two who lived on;",
        "yet one became",
        "its owner at last.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s14",
     "stanza": 14,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 14,
       "l": [
        "\"Segðu einn satt mér,",
        "svá láti áss þik",
        "heilan í haugi,",
        "sem þú hafir eigi",
        "Tyrfing með þér;",
        "trautt er þér at veita",
        "arf, Angantýr,",
        "eingabarni.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 14,
       "l": [
        "\"Segðu einn satt mér,",
        "svo láti ás þig",
        "heilan í haugi,",
        "sem þú hafir eigi",
        "Tyrfing með þér;",
        "trautt er þér að veita",
        "arf, Angantýr,",
        "eingabarni.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Hervör said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"Tell me nothing but the truth,",
        "so may the god let you",
        "rest whole in the mound,",
        "as you do not have",
        "Tyrfingr with you;",
        "you are loath to give",
        "the inheritance, Angantýr,",
        "to your only child.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s15",
     "stanza": 15,
     "on": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 15,
       "l": [
        "\"Hnigin er helgrind,",
        "haugar opnask,",
        "allr er í eldi",
        "eybarmr at sjá;",
        "atalt er úti",
        "um at lítask;",
        "skyntu, mær, ef þú mátt",
        "til skipa þinna.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 15,
       "l": [
        "\"Hnigin er helgrind,",
        "haugar opnast,",
        "allur er í eldi",
        "eybarmur að sjá;",
        "atalt er úti",
        "um að lítast;",
        "skyntu, mær, ef þú mátt",
        "til skipa þinna.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Angantýr said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"The gate of Hel has sunk down,",
        "the mounds are opening,",
        "all in fire",
        "the island's edge is to look upon;",
        "it is terrible outside",
        "to look about;",
        "hurry, maiden, if you can,",
        "to your ships.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s16",
     "stanza": 16,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 16,
       "l": [
        "\"Brennið eigi svá",
        "bál á nóttum,",
        "at ek við elda",
        "yðra hræðumk;",
        "skelfr-at meyju",
        "muntún hugar,",
        "þótt hon draug sjái",
        "i durum standa.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 16,
       "l": [
        "\"Brennið eigi svo",
        "bál á nóttum,",
        "að eg við elda",
        "yðra hræðumk;",
        "skelfr-at meyju",
        "muntún hugar,",
        "þótt hún draug sjái",
        "i durum standa.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Hervör said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"Burn no such",
        "pyres by night",
        "that at your fires",
        "I should be afraid;",
        "the maiden's heart,",
        "the home-field of her mind, does not tremble,",
        "even if she sees a ghost",
        "standing in the doorway.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s17",
     "stanza": 17,
     "on": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 17,
       "l": [
        "\"Segi ek þér, Hervör,",
        "- hlýð þú til enn,",
        "vísa dóttir, -",
        "þat er verða mun:",
        "sjá mun Tyrfingr,",
        "ef þú trúa mættir,",
        "ætt þinni, mær,",
        "allri spilla."
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 17,
       "l": [
        "\"Segi eg þér, Hervör,",
        "- hlýð þú til enn,",
        "vísa dóttir, -",
        "það er verða mun:",
        "sjá mun Tyrfingur,",
        "ef þú trúa mættir,",
        "ætt þinni, mær,",
        "allri spilla."
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Angantýr said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"I tell you, Hervör,",
        "— listen further,",
        "wise daughter —",
        "what will come to pass:",
        "this Tyrfingr will,",
        "if you could believe it,",
        "your kin, maiden,",
        "entirely destroy."
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s18",
     "stanza": 18,
     "on": [
      {
       "t": "v",
       "n": 18,
       "l": [
        "Muntu son geta,",
        "þann er síðan mun",
        "Tyrfing bera",
        "ok trúa magni;",
        "þann munu Heiðrek",
        "heita lýðar,",
        "sá mun ríkstr alinn",
        "und röðuls tjaldi.\""
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 18,
       "l": [
        "Muntu son geta,",
        "þann er síðan mun",
        "Tyrfing bera",
        "og trúa magni;",
        "þann munu Heiðreg",
        "heita lýðar,",
        "sá mun ríkstur alinn",
        "und röðuls tjaldi.\""
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "You will bear a son",
        "who afterwards will",
        "carry Tyrfingr",
        "and trust in his might;",
        "people will call him",
        "Heiðrekr;",
        "he will be born the mightiest",
        "under the sun's tent [sky].\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s19",
     "stanza": 19,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 19,
       "l": [
        "\"Ek vígi svá",
        "virða dauða,",
        "at ér skuluð",
        "allir liggja",
        "dauðir með draugum",
        "í dys fúnir;",
        "sel mér, Angantýr,",
        "út ór haugi",
        "dverga smíði;",
        "dugir-a þér at leyna.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 19,
       "l": [
        "\"Eg vígi svo",
        "virða dauða,",
        "að þér skuluð",
        "allir liggja",
        "dauðir með draugum",
        "í dys fúnir;",
        "sel mér, Angantýr,",
        "út úr haugi",
        "dverga smíði;",
        "dugir-a þér að leyna.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Hervör said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"I so lay a spell [?]",
        "on the dead men",
        "that you shall",
        "all lie",
        "dead among ghosts,",
        "rotted in the cairn;",
        "give me, Angantýr,",
        "out of the mound",
        "the work of dwarfs;",
        "it is no use for you to hide it.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s20",
     "stanza": 20,
     "on": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 20,
       "l": [
        "\"Kveðk-at þik, mær ung,",
        "mönnum líka,",
        "er þú um hauga",
        "hvarfar á nóttum",
        "gröfnum geiri",
        "ok með Gota málmi,",
        "hjálmi ok með brynju",
        "fyrir hallar dyrr.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 20,
       "l": [
        "\"Kveðk-at þig, mær ung,",
        "mönnum líka,",
        "er þú um hauga",
        "hvarfar á nóttum",
        "gröfnum geiri",
        "og með Gota málmi,",
        "hjálmi og með brynju",
        "fyrir hallar dyr.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Angantýr said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"I do not call you, young maiden,",
        "like other people,",
        "when around the mounds",
        "you roam by night",
        "with an engraved spear",
        "and with the metal of the Goths [?],",
        "with helmet and with mail-coat,",
        "before the doors of the hall.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s21",
     "stanza": 21,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 21,
       "l": [
        "\"Maðr þóttumk ek",
        "mennskr til þessa,",
        "áðr ek sali yðra",
        "sækja réðak;",
        "sel þú mér ór haugi,",
        "þann er hatar brynjur,",
        "hlífum hættan",
        "Hjálmars bana.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 21,
       "l": [
        "\"Maður þóttumk eg",
        "mennskur til þessa,",
        "áður eg sali yðra",
        "sækja réðak;",
        "sel þú mér úr haugi,",
        "þann er hatar brynjur,",
        "hlífum hættan",
        "Hjálmars bana.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Hervör said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"I thought myself",
        "a human being until now,",
        "before I set out",
        "to seek your halls;",
        "give me from the mound",
        "the one that hates mail-coats,",
        "the danger to shields,",
        "Hjálmarr's bane.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s22",
     "stanza": 22,
     "on": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 22,
       "l": [
        "\"Liggr mér und herðum",
        "Hjálmars bani,",
        "allr er hann útan",
        "eldi sveipinn;",
        "mey veit ek enga",
        "moldar hvergi,",
        "at þann hjör þori",
        "í hendr nema.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 22,
       "l": [
        "\"Liggur mér und herðum",
        "Hjálmars bani,",
        "allur er hann utan",
        "eldi sveipinn;",
        "mey veit eg enga",
        "moldar hvergi,",
        "að þann hjör þori",
        "í hendur nema.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Angantýr said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"Under my shoulders lies",
        "Hjálmarr's bane,",
        "it is all on the outside",
        "wrapped in fire;",
        "I know no maiden",
        "anywhere on earth",
        "who would dare that sword",
        "to take into her hands.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s23",
     "stanza": 23,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 23,
       "l": [
        "\"Ek mun hirða",
        "ok í hendr nema",
        "hvassan mæki,",
        "ef ek hafa mættak;",
        "uggi ek eigi",
        "eld brennanda,",
        "þegar loga lægir,",
        "er ek lít yfir.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 23,
       "l": [
        "\"Eg mun hirða",
        "og í hendur nema",
        "hvassan mæki,",
        "ef eg hafa mættak;",
        "uggi eg eigi",
        "eld brennanda,",
        "þegar loga lægir,",
        "er eg lít yfir.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Hervör said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"I will keep",
        "and take into my hands",
        "the sharp sword,",
        "if I may have it;",
        "I do not fear",
        "the burning fire;",
        "at once the flame dies down",
        "when I look over it.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s24",
     "stanza": 24,
     "on": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 24,
       "l": [
        "\"Heimsks ertu, Hervör,",
        "hugar eigandi,",
        "er þú at augum",
        "í eld hrapar;",
        "heldr vil ek selja þér",
        "sverð ór haugi,",
        "mær in unga,",
        "mák-at ek þér synja.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 24,
       "l": [
        "\"Heimsks ertu, Hervör,",
        "hugar eigandi,",
        "er þú að augum",
        "í eld hrapar;",
        "heldur vil eg selja þér",
        "sverð úr haugi,",
        "mær hin unga,",
        "mák-at eg þér synja.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Angantýr said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"Of a foolish mind, Hervör,",
        "you are the owner,",
        "when with open eyes",
        "you rush into the fire;",
        "rather will I give you",
        "the sword from the mound,",
        "young maiden;",
        "I cannot refuse you.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s25",
     "stanza": 25,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 25,
       "l": [
        "\"Vel gerðir þú,",
        "víkinga niðr,",
        "er þú seldir mér",
        "sverð ór haugi;",
        "betr þykkjumk nú,",
        "bragningr, hafa",
        "en ek Nóregi",
        "næðak öllum.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 25,
       "l": [
        "\"Vel gerðir þú,",
        "víkinga niður,",
        "er þú seldir mér",
        "sverð úr haugi;",
        "betur þykkjumk nú,",
        "bragningur, hafa",
        "en eg Nóregi",
        "næðak öllum.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Hervör said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"You did well,",
        "kinsman of vikings,",
        "when you gave me",
        "the sword from the mound;",
        "better it seems to me now,",
        "prince, to have it",
        "than if I had won",
        "all of Nóregr [Norway].\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s26",
     "stanza": 26,
     "on": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 26,
       "l": [
        "\"Veizt eigi þú,",
        "- vesöl ertu mála,",
        "fláráð kona, -",
        "hví þú fagna skalt;",
        "sjá mun Tyrfingr,",
        "ef þú trúa mættir,",
        "ætt þinni, mær,",
        "allri spilla.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Angantýr kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 26,
       "l": [
        "\"Veist eigi þú,",
        "- vesöl ertu mála,",
        "fláráð kona, -",
        "hví þú fagna skalt;",
        "sjá mun Tyrfingur,",
        "ef þú trúa mættir,",
        "ætt þinni, mær,",
        "allri spilla.\""
       ]
      }
     ],
     "en": [
      {
       "t": "p",
       "s": "Angantýr said:",
       "sp": true
      },
      {
       "t": "v",
       "l": [
        "\"You do not know",
        "— wretched you are in your words,",
        "deceitful woman —",
        "why you should rejoice;",
        "this Tyrfingr will,",
        "if you could believe it,",
        "your kin, maiden,",
        "entirely destroy.\""
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
     "is_cont": false,
     "quoted_in": [],
     "en_draft": true
    },
    {
     "id": "hvk-s27",
     "stanza": 27,
     "on": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 27,
       "l": [
        "\"Ek mun ganga",
        "til gjálfrmara;",
        "nú er hilmis mær",
        "í hugum góðum;",
        "lítt ræki ek þat,",
        "lofðunga niðr,",
        "hvé synir mínir",
        "síðan deila.\""
       ]
      }
     ],
     "is": [
      {
       "t": "p",
       "s": "Hervör kvað:",
       "sp": true
      },
      {
       "t": "v",
       "n": 27,
       "l": [
        "\"Eg mun ganga",
        "til gjálfrmara;",
        "nú er hilmis mær",
        "í hugum góðum;",
