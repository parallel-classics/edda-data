     "stanza": 10,
     "on": [
      {
       "t": "v",
       "n": 10,
       "l": [
        "Kæmi-a Grótti",
        "ór gréa fjalli",
        "né sá inn harði",
        "hallr ór jörðu,",
        "né mæli svá",
        "mær bergrisa,",
        "ef vissi vit",
        "vætr til hennar."
       ]
      }
     ],
     "is": [
