       "t": "v",
       "n": 10,
       "l": [
        "Kæmi-a Grótti",
        "úr gréa fjalli",
        "né sá hinn harði",
        "hallur úr jörðu,",
        "né mæli svo",
        "mær bergrisaættar,",
        "ef vissi vit",
        "vætur til hennar."
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "Grótti would not have come",
        "out of the grey mountain,",
        "nor that hard",
        "rock out of the earth,",
        "nor would she grind so,",
        "the maiden of mountain-giants,",
        "if we two knew",
        "nothing of it [?]."
       ]
