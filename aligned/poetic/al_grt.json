     "stanza": 6,
     "on": [
      {
       "t": "v",
       "n": 6,
       "l": [
        "Hér skyli engi",
        "öðrum granda,",
        "til böls búa",
        "né til bana orka,",
        "né höggva því",
        "hvössu sverði,",
        "þó at bana bróður",
        "bundinn finni.\""
       ]
      }
     ],
     "is": [
