    {
     "id": "grt-s5",
     "stanza": 5,
     "on": [
      {
       "t": "v",
       "n": 5,
       "l": [
        "\"Auð mölum Fróða,",
        "mölum alsælan,",
        "mölum fjölð féar",
        "á feginslúðri;",
        "siti hann á auði,",
        "sofi hann á dúni,",
        "vaki hann at vilja,",
        "þá er vel malit."
       ]
      }
     ],
     "is": [
      {
       "t": "v",
       "n": 5,
       "l": [
        "\"Auð mölum Fróða,",
        "mölum alsælan,",
        "mölum fjölð féar",
        "á feginslúðri;",
        "siti hann á auði,",
        "sofi hann á dúni,",
        "vaki hann að vilja,",
        "þá er vel malið."
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "\"Wealth we grind for Fróði,",
        "we grind him all-blessed,",
        "we grind abundance of riches",
        "on the mill of gladness;",
        "may he sit on wealth,",
        "may he sleep on down,",
        "may he wake to his wishes,",
        "then it is well ground."
       ]
      }
     ],
     "en_stanzas": [],
     "en_cont": false,
