       "t": "v",
       "n": 11,
       "l": [
        "Vér vetur níu",
        "várum leikur",
        "öflgar alnar",
        "fyr jörð neðan;",
        "stóðu meyjar",
        "að meginverkum,",
        "færðum sjalfar",
        "setberg úr stað."
       ]
      }
     ],
     "en": [
      {
       "t": "v",
       "l": [
        "We for nine winters",
        "were playmates,",
        "reared up mighty",
        "beneath the earth;",
        "the maidens stood",
        "at mighty works,",
        "we ourselves moved",
        "a flat-topped mountain from its place."
       ]
      }
     ],
     "en_stanzas": [],
