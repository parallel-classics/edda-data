     "stanza": 8,
     "on": [
      {
       "t": "v",
       "n": 8,
       "l": [
        "\"Var-at-tu, Fróði,",
        "fullspakr of þik,",
        "málvinr manna,",
        "er þú man keyptir;",
        "kaustu at afli",
