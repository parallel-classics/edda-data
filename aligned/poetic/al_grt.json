       "t": "v",
       "n": 11,
       "l": [
        "Vér vetr níu",
        "várum leikur",
        "öflgar alnar",
        "fyr jörð neðan;",
        "stóðu meyjar",
        "at meginverkum,",
        "færðum sjalfar",
        "setberg ór stað."
       ]
      }
     ],
     "is": [
